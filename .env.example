# Axiom Protocol Environment Configuration Template
# Copy this file to .env: cp .env.example .env

# Telegram Relay Ingestion (Optional)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Settlement Endpoint Details
PAYTM_VPA=merchant@upi
MERCHANT_NAME=Axiom Settlement Node

# Server & Database
PORT=3000
DB_PATH=./axiom.db

# Settlement TTL & Allocation Constraints
MIN_AMOUNT_INR=1
MAX_AMOUNT_INR=10000
ORDER_EXPIRY_MINUTES=10
